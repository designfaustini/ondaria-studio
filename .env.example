# ------------------------------------------------------------------
# Ondaria Studio: configuração. Copie para .env e preencha.
# O .env fica FORA da pasta pública. Nunca versione o .env.
# ------------------------------------------------------------------
APP_NAME="Ondaria Studio"
APP_ENV=production            # production | local
APP_URL=https://radio.seudominio.com.br
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
# Se o sistema rodar numa subpasta (ex.: https://dominio.com/studio), informe /studio
APP_BASE_PATH=

# Banco: mysql (cPanel) | sqlite (só desenvolvimento)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usuario_ondaria
DB_USER=usuario_ondaria
DB_PASS=
DB_SQLITE_PATH=storage/database.sqlite

# Cadastro público de novas rádios (true/false).
# Deixe false até preencher os dados legais abaixo e revisar os termos.
SIGNUP_ENABLED=false

# ---------- Identificação do fornecedor e LGPD ----------
# Aparecem no rodapé, em /termos, /privacidade, /direitos-autorais e /contato.
# Decreto 7.962/2013 (comércio eletrônico) e LGPD art. 41 (encarregado).
COMPANY_NAME=""
COMPANY_DOC=""
COMPANY_ADDRESS=""
CONTACT_EMAIL=""
DPO_NAME=""
DPO_EMAIL=""
COPYRIGHT_EMAIL=""
LEGAL_FORO=""
HOSTING_INFO=""
# Ao mudar os termos, troque a versão: todos aceitam de novo no próximo acesso.
TERMS_VERSION=2026-11-17

# ---------- Retenção de dados (dias), aplicada por: php bin/console.php cleanup ----------
LOG_RETENTION_DAYS=730        # registro de execução (relatórios de anunciantes)
ACCESS_LOG_DAYS=180           # registros de acesso: o Marco Civil (art. 15) exige no mínimo 6 meses
AUDIT_RETENTION_DAYS=365      # auditoria administrativa
CLOSING_GRACE_DAYS=30         # carência entre o pedido de encerramento da rádio e a exclusão definitiva
